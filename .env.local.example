# API key de https://resend.com/api-keys
RESEND_API_KEY=

# Correo que recibe los mensajes del formulario de contacto
CONTACT_TO_EMAIL=hola@regest.es

# Remitente. Si tu dominio ya está verificado en Resend, usa tu propio dominio
# (ej. "ReGest <hola@regest.es>"). Si no, usa onboarding@resend.dev, que
# funciona sin verificar nada.
CONTACT_FROM_EMAIL=ReGest <hola@regest.es>
